# Bu faylni ".env" deb nusxalang va qiymatlarni to'ldiring.

# ---- Telegram
# @BotFather bergan token
BOT_TOKEN=
# Yangi ariza va xabarlar keladigan chat/guruh ID (masalan 123456789 yoki -100...)
ADMIN_CHAT_ID=

# ---- Xavfsizlik
# Uzun tasodifiy kalit:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Serverda doim False. Faqat kompyuterda sinashda True
DEBUG=False
# Sayt domeni yoki server IP, vergul bilan:  bot.example.uz,123.45.67.89
ALLOWED_HOSTS=127.0.0.1,localhost
# HTTPS domen bo'lsa:  https://bot.example.uz
CSRF_TRUSTED_ORIGINS=
# Sayt HTTPS orqali ochilsa True (nginx/hosting HTTPS bergan bo'lsa)
USE_HTTPS=False

# ---- Birinchi admin (ensure_admin buyrug'i yaratadi, bor bo'lsa tegmaydi)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Ma'lumotlar papkasi: baza (db.sqlite3) va yuklangan fayllar (media/). Bo'sh = loyiha papkasi
DATA_DIR=

# ---- Faqat webhook rejimi (PythonAnywhere bepul tarifi)
# Telegram so'rovini tasdiqlovchi maxfiy kalit (faqat harf, raqam, _ va -)
WEBHOOK_SECRET=
# PythonAnywhere bepul tarifida:  http://proxy.server:3128
TELEGRAM_PROXY=
